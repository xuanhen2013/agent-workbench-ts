# OpenAI-compatible API root. Keep the /v1 prefix; the SDK appends /responses.
OPENAI_BASE_URL=https://your-openai-compatible-host/v1
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
# Optional. Supported values depend on the selected model; leave empty to use
# the model default: none, minimal, low, medium, high, xhigh, max.
OPENAI_DEFAULT_REASONING_EFFORT=medium
TAVILY_KEY=replace-with-your-tavily-api-key

# Bun HTTP server.
PORT=7233
NODE_ENV=development

# debug 会额外显示工具参数；生产环境默认输出 JSON 日志。
LOG_LEVEL=debug

# Optional local question signals. Also used by the AI Search corpus uploader.
# When omitted, the app still uses built-in verified answer evidence.
INTERVIEW_BANK_DIR=

# Local file-backed 06D LearningMemory. Tests use SQLite :memory: instead.
LEARNING_MEMORY_SQLITE_PATH=agent-workbench.sqlite

# Optional shared Cloudflare AI Search corpus: verified answer evidence plus
# public JD/interview-bank question signals are isolated by trusted metadata.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_SEARCH_INSTANCE=replace-with-ai-search-instance

# Local JD source used only by scripts/upload-ai-search-corpus.ts. The directory
# itself is not uploaded; only its sanitized Markdown documents are.
JD_MARKET_CORPUS_DIR=

# Optional override for a public endpoint, namespace endpoint, or internal proxy.
# Leave empty when using the private account-level REST API above.
CLOUDFLARE_AI_SEARCH_SEARCH_URL=

# Optional Cloudflare D1 QuestionBank. All three values are required to enable it;
# otherwise the app uses an in-memory question bank for local development.
CLOUDFLARE_D1_DATABASE_NAME=replace-with-d1-database-name
CLOUDFLARE_D1_DATABASE_ID=replace-with-d1-database-id
